# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# ---- LLM：DeepSeek（OpenAI 兼容协议）----
# API Key 在 https://platform.deepseek.com 创建
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# DeepSeek 默认开启思考模式。为 true 时，每次请求都显式传 thinking 参数（结构化调用默认关闭思考）。
# 换成不认识该参数的服务商时改为 false。
LLM_SEND_THINKING_PARAM=true

# ---- Embedding / Reranker：硅基流动 ----
# API Key 在 https://cloud.siliconflow.cn 创建
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 运行数据目录（论文缓存、数据库）----
DATA_DIR=data

# 访问 arXiv 需要代理时，设置标准代理环境变量即可（httpx 会自动读取）：
# HTTPS_PROXY=http://127.0.0.1:7890

# ---- Web 服务（paperlens serve / paperlens ui）----
# 默认只监听本机。需要局域网 / 公网访问时改 API_HOST，并务必设置 API_KEY（请求头 X-API-Key）。
# API_HOST=127.0.0.1
# API_PORT=8000
# API_KEY=
# Streamlit 界面连接的后端地址
# PAPERLENS_API=http://127.0.0.1:8000
